{
  "schemaVersion": 1,
  "id": "xyb.records",
  "name": "我的资料",
  "version": "0.3.0",
  "description": "把散落的检查报告、影像与就诊资料归到本地资料库，整理成可追溯的病案，并生成患者可读的病情摘要。",
  "main": "main.js",
  "contributes": {
    "views": [
      {
        "id": "records",
        "title": { "en": "My Records", "zh-CN": "我的资料" },
        "icon": "folder",
        "entry": "views/records.html",
        "order": 10
      }
    ],
    "commands": [
      {
        "id": "xyb.records.import",
        "title": "小胰宝：导入资料",
        "keywords": ["导入", "资料", "病历", "报告", "import"]
      },
      {
        "id": "xyb.records.summary",
        "title": "小胰宝：生成病情摘要",
        "keywords": ["摘要", "总结", "summary"]
      },
      {
        "id": "xyb.records.organize",
        "title": "小胰宝：整理病案",
        "keywords": ["整理", "病案", "归档", "分类", "organize"]
      }
    ],
    "skills": ["skills/patient-summary.md"],
    "settings": [
      {
        "key": "vaultDir",
        "title": "资料库位置（仅作提示；生成摘要时仍需你亲自选择目录）",
        "type": "string",
        "default": ""
      }
    ]
  },
  "permissions": [
    "ui.view",
    "fs.read",
    "fs.write",
    "agent.prompt.inject",
    "models.list",
    "agent.complete"
  ],
  "fs": {
    "read": { "root": "userSelected" },
    "write": { "root": "userSelected" }
  },
  "engines": {
    "piDesktop": ">=0.1.0"
  },
  "activationEvents": ["onStartup", "onCommand:xyb.records.import", "onCommand:xyb.records.summary", "onCommand:xyb.records.organize"]
}