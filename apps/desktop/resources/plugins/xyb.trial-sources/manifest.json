{
  "schemaVersion": 1,
  "id": "xyb.trial-sources",
  "name": "中国与区域试验来源",
  "version": "0.2.0",
  "description": "可选数据源扩展：中国临床试验注册中心（ChiCTR）、Veeva CTV 与中国药物临床试验登记与信息公示平台。默认关闭，需用户显式启用；启用后助手可检索中国注册试验。",
  "main": "main.js",
  "contributes": {
    "views": [
      {
        "id": "sources",
        "title": { "en": "Trial Sources", "zh-CN": "试验来源" },
        "icon": "server",
        "entry": "views/sources.html",
        "order": 21
      }
    ],
    "commands": [
      {
        "id": "xyb.trial-sources.list",
        "title": "小胰宝：看看有哪些试验来源",
        "keywords": ["数据源", "来源", "中国", "ChiCTR", "Veeva", "CTV", "登记平台", "药物临床试验登记"]
      }
    ],
    "skills": ["skills/china-trials.md", "skills/china-drug-trials.md"],
    "mcpServers": [
      {
        "id": "chictr",
        "label": "ChiCTR 中国临床试验注册中心",
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "chictr-mcp-server@2.0.2"]
      },
      {
        "id": "veeva-ctv",
        "label": "Veeva CTV（本地索引）",
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "ctv-mcp-server@0.1.0"]
      },
      {
        "id": "chinadrugtrials",
        "label": "中国药物临床试验登记与信息公示平台",
        "transport": "stdio",
        "command": "./mcp/chinadrugtrials-mcp.mjs"
      }
    ]
  },
  "permissions": ["ui.view", "agent.prompt.inject", "mcp.server.local"],
  "settings": [
    {
      "key": "veevaDataDir",
      "type": "string",
      "title": "Veeva CTV 数据目录",
      "description": "Veeva CTV 本地索引（ctv.db）所在目录。留空（推荐）使用 ~/.ctv-mcp：首次启动时若无索引，会自动把随应用分发的种子数据复制到这里，之后你的刷新结果也写在这里。仅当你把索引放在别处时才需要填。",
      "default": ""
    }
  ],
  "engines": {
    "piDesktop": ">=0.1.0"
  },
  "activationEvents": ["onStartup", "onCommand:xyb.trial-sources.list"]
}
